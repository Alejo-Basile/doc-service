# Valores FICTICIOS. Copiar a .env y completar localmente. Nunca commitear el .env real.

# --- HTTP ---
HTTP_PORT=8080
DEBUG=false

# --- MongoDB (Replica Set requerido por Change Streams, SPEC 3.6) ---
MONGO_URI=mongodb://changeme:changeme@localhost:27017/documents?replicaSet=rs0
MONGO_DATABASE=documents

# --- MinIO ---
# Endpoint PUBLICO usado para firmar URLs prefirmadas (SPEC 5.1 / ADR-0016 en infra/).
# La firma SigV4 depende del host: DEBE coincidir con el hostname publico dedicado de S3.
MINIO_PUBLIC_ENDPOINT=https://s3.example.com
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET_RAW=raw-pdfs
MINIO_BUCKET_TXT=extracted-txt

# --- Redis (cliente Sentinel-aware, SPEC 3.5) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=changeme
REDIS_STREAM_KEY=stream:pdf-processing

# --- Webhook MinIO (secreto compartido, SPEC 9) ---
MINIO_WEBHOOK_SECRET=changeme

# --- Seguridad interna (header X-Internal-Token en /internal/*) ---
# Protege history/retry/cancel contra accesos no autorizados dentro de la red interna.
INTERNAL_TOKEN=changeme

# --- Reglas de negocio (defaults entre paréntesis, SPEC 4 y 11.5) ---
MAX_PDF_BYTES=26214400            # 25 MB (SPEC 5.1)
RECONCILE_INTERVAL_MIN=10         # intervalo del job de reconciliación (10)
DOC_UPLOAD_GRACE_MIN=30           # gracia de subida; debe ser >= 2x RECONCILE_INTERVAL_MIN (30)
MIN_SAFETY_AGE_MIN=15             # edad mínima de seguridad del reconciliador; >= RECONCILE_INTERVAL_MIN (15)
